---
import '../styles/global.css';
import Chat from '../components/Chat.astro';
import { site } from '../data/site';
import { services } from '../data/services';

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} – Sửa chữa, setup, bảo dưỡng đàn guitar`;
const nav = [
  ['/dich-vu/', 'Dịch vụ'],
  ['/gallery/', 'Gallery'],
  ['/blog/', 'Blog'],
  ['/lien-he/', 'Liên hệ'],
];
const path = Astro.url.pathname;
const tel = `tel:${site.phone.replaceAll(' ', '')}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: site.description,
  telephone: site.phone,
  address: site.address,
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500&family=Playfair+Display:ital@0;1&display=swap" rel="stylesheet" />
    <!-- Đặt giao diện sáng/tối trước khi vẽ trang để không bị nháy -->
    <script is:inline>
      (() => {
        let t;
        try { t = localStorage.getItem('theme'); } catch {}
        document.documentElement.dataset.theme = t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-cream font-sans font-light text-char antialiased">
    <a href="#noi-dung" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-cream focus:px-4 focus:py-3">Bỏ qua, tới nội dung</a>
    <!-- Dải thông báo -->
    <a href={site.announcement.link} class="block bg-panel px-4 py-3 text-center text-xs tracking-wide hover:text-gold-deep">
      {site.announcement.text} →
    </a>

    <header class="top-0 z-30 md:sticky border-b border-line bg-cream/95 backdrop-blur">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-8 gap-y-2 px-5 py-4 md:grid md:grid-cols-[1fr_auto_1fr] md:px-8">
        <a href="/" class="font-display text-2xl tracking-[0.2em] uppercase">{site.name}</a>
        <nav aria-label="Chính" class="order-3 flex w-full gap-6 text-sm md:order-none md:w-auto md:gap-9">
          {
            nav.map(([href, label]) => (
              <a
                href={href}
                aria-current={path.startsWith(href) ? 'page' : undefined}
                class="border-b border-transparent py-2.5 hover:border-char aria-[current]:border-gold-deep"
              >
                {label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex items-center gap-4 text-sm md:ml-0 md:justify-self-end">
          <button id="theme-toggle" aria-label="Chuyển giao diện sáng / tối" class="grid size-11 cursor-pointer place-items-center hover:text-gold-deep">
            <svg viewBox="0 0 24 24" class="size-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
            <svg viewBox="0 0 24 24" class="hidden size-5 dark:block" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M5 19l1.5-1.5M17.5 6.5 19 5"></path></svg>
          </button>
          <a href={tel} class="hidden hover:text-gold-deep sm:block">{site.phone}</a>
          <a href={site.zalo} target="_blank" rel="noopener" class="link py-2.5">Đặt lịch qua Zalo</a>
        </div>
      </div>
    </header>

    <main id="noi-dung"><slot /></main>

    <footer class="mt-24 bg-panel">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 text-sm sm:grid-cols-2 md:px-8 lg:grid-cols-4">
        <div>
          <p class="font-display text-2xl tracking-[0.2em] uppercase">{site.name}</p>
          <p class="mt-4 max-w-xs text-mute">{site.tagline}</p>
        </div>
        <div>
          <p class="eyebrow">Dịch vụ</p>
          <ul class="mt-2">
            {services.map((s) => <li><a href={`/dich-vu/${s.slug}/`} class="block py-2 hover:text-gold-deep">{s.name}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="eyebrow">Khám phá</p>
          <ul class="mt-2">
            {nav.map(([href, label]) => <li><a href={href} class="block py-2 hover:text-gold-deep">{label}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="eyebrow">Liên hệ</p>
          <div class="mt-4 space-y-2">
            <p>{site.address}</p>
            <p><a href={tel} class="hover:text-gold-deep">{site.phone}</a></p>
            <div class="pt-2 text-mute">{site.hours.map(([d, h]) => <p>{d}: {h}</p>)}</div>
          </div>
        </div>
      </div>
      <p class="border-t border-line px-5 pb-24 pt-5 text-center text-xs text-mute">© {new Date().getFullYear()} {site.name}</p>
    </footer>

    <Chat />
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>
