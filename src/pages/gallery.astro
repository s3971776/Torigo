---
import Layout from '../layouts/Layout.astro';
import Tile from '../components/Tile.astro';
import { services, serviceBySlug } from '../data/services';
import { gallery } from '../data/gallery';
import { getImage } from 'astro:assets';
import { photo } from '../data/photos';

// Ảnh lớn cho lightbox
const items = await Promise.all(
  gallery.map(async (g) => {
    const img = await photo(g.photo);
    const full = await getImage({ ...img.props, width: 1600, height: Math.round((1600 * img.height) / img.width) });
    return { ...g, full: full.src };
  }),
);
---

<Layout title="Gallery" description="Ảnh các ca setup, vệ sinh, điện, refret và repaint đã làm tại Torigo.">
  <section class="mx-auto max-w-7xl px-5 md:px-8 pt-12 md:pt-20">
    <h1 class="text-5xl md:text-6xl">Gallery</h1>

    <div id="filters" class="mt-8 flex flex-wrap gap-2 text-sm">
      <button data-filter="" aria-pressed="true" class="filter">Tất cả</button>
      {services.map((s) => <button data-filter={s.slug} aria-pressed="false" class="filter">{s.name}</button>)}
    </div>

    <!-- Masonry bằng CSS columns thuần -->
    <div id="grid" class="mt-8 columns-2 gap-3 md:columns-3 lg:columns-4">
      {
        items.map((item, i) => (
          <button
            class="group mb-3 block w-full cursor-pointer break-inside-avoid"
            data-service={item.service ?? ''}
            data-title={item.title}
            data-full={item.full}
            data-name={serviceBySlug[item.service ?? '']?.name ?? ''}
          >
            <Tile item={item} i={i} />
          </button>
        ))
      }
    </div>
  </section>

  <dialog id="lightbox" class="m-auto w-[min(94vw,1000px)] overflow-hidden rounded-sm bg-panel p-0 text-char backdrop:bg-black/40">
    <img id="lb-image" alt="" class="max-h-[72vh] w-full bg-panel object-contain" />
    <div class="flex flex-wrap items-center justify-between gap-4 p-5">
      <p id="lb-title" class="text-2xl"></p>
      <div class="flex gap-3">
        <a id="lb-link" class="btn"></a>
        <form method="dialog"><button class="btn btn-ghost">Đóng</button></form>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .filter {
    padding: 0.65rem 1rem;
    border-radius: 2px;
    cursor: pointer;
    color: var(--color-mute);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .filter[aria-pressed='true'] {
    background: var(--color-gold);
    color: var(--color-ink);
    box-shadow: none;
  }
</style>

<script>
  const items = [...document.querySelectorAll<HTMLElement>('#grid [data-service]')];
  const filters = [...document.querySelectorAll<HTMLElement>('#filters [data-filter]')];

  function apply(slug: string) {
    for (const f of filters) f.setAttribute('aria-pressed', String(f.dataset.filter === slug));
    for (const it of items) it.hidden = !!slug && it.dataset.service !== slug;
  }
  for (const f of filters) f.addEventListener('click', () => apply(f.dataset.filter!));
  // Link từ trang dịch vụ: /gallery/?loc=setup
  const initial = new URLSearchParams(location.search).get('loc');
  if (initial && filters.some((f) => f.dataset.filter === initial)) apply(initial);

  const lb = document.querySelector<HTMLDialogElement>('#lightbox')!;
  const link = lb.querySelector<HTMLAnchorElement>('#lb-link')!;
  for (const it of items) {
    it.addEventListener('click', () => {
      lb.querySelector('#lb-title')!.textContent = it.dataset.title!;
      const img = lb.querySelector<HTMLImageElement>('#lb-image')!;
      img.src = it.dataset.full!;
      img.alt = it.dataset.title!;
      link.textContent = `Dịch vụ: ${it.dataset.name} →`;
      link.href = `/dich-vu/${it.dataset.service}/`;
      link.hidden = !it.dataset.name; // ảnh chưa gắn dịch vụ thì ẩn nút
      lb.showModal();
    });
  }
  // Bấm ra nền để đóng
  lb.addEventListener('click', (e) => e.target === lb && lb.close());
</script>
