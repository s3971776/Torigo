---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout title="Liên hệ" description={`Địa chỉ, giờ mở cửa, Zalo và số điện thoại của ${site.name}.`}>
  <section class="mx-auto max-w-7xl px-5 md:px-8 pt-12 md:pt-20">
    <h1 class="text-5xl md:text-6xl">Liên hệ</h1>

    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <div class="space-y-8">
        <div>
          <h2 class="text-2xl text-gold-deep">Địa chỉ</h2>
          <p class="mt-2 text-lg">{site.address}</p>
          <a href={site.mapUrl} target="_blank" rel="noopener" class="mt-1 inline-block text-sm text-mute underline hover:text-char">
            Mở Google Maps
          </a>
        </div>
        <div>
          <h2 class="text-2xl text-gold-deep">Giờ mở cửa</h2>
          <dl class="mt-2 grid max-w-xs grid-cols-2 gap-y-1">
            {
              site.hours.map(([d, h]) => (
                <>
                  <dt class="text-mute">{d}</dt>
                  <dd>{h}</dd>
                </>
              ))
            }
          </dl>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={site.zalo} target="_blank" rel="noopener" class="btn">Chat Zalo với thợ</a>
          <a href={`tel:${site.phone.replaceAll(' ', '')}`} class="btn btn-ghost">Gọi {site.phone}</a>
        </div>
      </div>

      <!-- ponytail: ô giữ chỗ bản đồ. Khi có địa chỉ thật, thay bằng <iframe loading="lazy"> nhúng Google Maps. -->
      <a
        href={site.mapUrl}
        target="_blank"
        rel="noopener"
        class="grid aspect-[4/3] place-items-center rounded-sm border border-line bg-panel text-mute hover:text-char"
      >
        Bản đồ: bấm để mở Google Maps
      </a>
    </div>
  </section>
</Layout>
