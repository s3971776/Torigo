---
import Layout from '../../layouts/Layout.astro';
import Pricing from '../../components/Pricing.astro';
import { site } from '../../data/site';
import { services } from '../../data/services';
---

<Layout title="Bảng giá dịch vụ" description="Bảng giá thay dây, setup, vệ sinh, thay nut, điện, refret và repaint đàn guitar tại Torigo.">
  <section class="mx-auto max-w-7xl px-5 md:px-8 pt-12 md:pt-20">
    <h1 class="text-5xl md:text-6xl">Bảng giá dịch vụ</h1>
    <p class="mt-4 max-w-xl text-mute">Sửa chữa · Setup · Bảo dưỡng đàn guitar. Đơn vị: VNĐ.</p>

    <!-- Mục lục nhanh -->
    <nav aria-label="Dịch vụ" class="mt-8 flex flex-wrap gap-2 text-sm">
      {
        services.map((s) => (
          <a href={`#${s.slug}`} class="rounded-sm px-4 py-2.5 text-mute shadow-[inset_0_0_0_1px_var(--color-line)] hover:text-char">
            {s.name}
          </a>
        ))
      }
    </nav>

    <div class="mt-10 grid items-start gap-5 md:grid-cols-2">
      {
        services.map((s, i) => (
          <article id={s.slug} class="reveal scroll-mt-28 rounded-sm border border-line bg-panel p-6 sm:p-8">
            <p class="text-lg text-gold-deep">0{i + 1}</p>
            <h2 class="mt-1 text-3xl">
              <a href={`/dich-vu/${s.slug}/`} class="hover:text-gold-deep">{s.name}</a>
            </h2>
            <p class="mb-6 mt-2 text-sm text-mute">{s.short}</p>
            <Pricing s={s} />
            <div class="mt-6 flex flex-wrap gap-3">
              <button class="btn" data-ask={`Mình muốn hỏi về dịch vụ ${s.name}: `}>Hỏi về dịch vụ này</button>
              <a href={`/dich-vu/${s.slug}/`} class="btn btn-ghost">Chi tiết</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 md:px-8 pt-16">
    <div class="reveal flex flex-wrap items-center justify-between gap-6 rounded-sm border border-line bg-panel p-8 sm:p-12">
      <div>
        <h2 class="text-4xl">Đặt lịch hoặc hỏi giá</h2>
        <p class="mt-3 text-mute">Gọi hoặc nhắn Zalo {site.phone}.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={site.zalo} target="_blank" rel="noopener" class="btn">Chat Zalo với thợ</a>
        <a href={`tel:${site.phone.replaceAll(' ', '')}`} class="btn btn-ghost">Gọi {site.phone}</a>
      </div>
    </div>
  </section>
</Layout>
