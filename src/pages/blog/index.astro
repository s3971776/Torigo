---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
---

<Layout title="Blog kiến thức guitar điện" description="Kiến thức setup, bảo quản, chọn pickup và nhật ký các ca sửa tại xưởng.">
  <section class="mx-auto max-w-3xl px-4 pt-12 md:pt-20">
    <h1 class="text-5xl md:text-6xl">Blog</h1>
    <div class="mt-10">
      {
        posts.map((p) => (
          <a href={`/blog/${p.id}/`} class="reveal group block border-t border-line py-8">
            <time class="text-xs text-mute">{p.data.date.toLocaleDateString('vi-VN')}</time>
            <h2 class="mt-2 text-3xl group-hover:text-gold-deep">{p.data.title}</h2>
            <p class="mt-3 text-mute">{p.data.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
